[Unit]
Description=SakuraChat atomic image release update
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/sakura/deploy/swarm/update.py --apply
TimeoutStartSec=7200
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
