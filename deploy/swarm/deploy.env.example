# Copy to /etc/sakura/deploy.env on the server, not into Git.
SAKURA_PUBLIC_HOST=chat.example.com
SAKURA_SMTP_HOST=smtp.qq.com
# Set these to immutable digests from the successful GitHub Actions summary.
SERVER_IMAGE=ghcr.io/shimamurads/sakurachatserver-server@sha256:REPLACE
VERIFY_IMAGE=ghcr.io/shimamurads/sakurachatserver-verify@sha256:REPLACE
