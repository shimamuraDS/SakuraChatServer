# Example only. Requires nginx built with HTTP SSL and stream SSL modules.
# Replace certificate paths. Raw application listeners stay on 127.0.0.1.
events { worker_connections 1024; }
http {
    access_log off;
    client_max_body_size 16k;
    client_header_timeout 15s;
    client_body_timeout 15s;
    server {
        listen 8443 ssl;
        ssl_certificate     C:/sakura-certs/server.pem;
        ssl_certificate_key C:/sakura-certs/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        location / {
            proxy_pass http://127.0.0.1:8081;
            proxy_connect_timeout 3s;
            proxy_read_timeout 15s;
        }
    }
}
stream {
    server {
        listen 18090 ssl;
        ssl_certificate     C:/sakura-certs/server.pem;
        ssl_certificate_key C:/sakura-certs/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        proxy_pass 127.0.0.1:8090;
        proxy_connect_timeout 3s;
        proxy_timeout 15m;
    }
    server {
        listen 18091 ssl;
        ssl_certificate     C:/sakura-certs/server.pem;
        ssl_certificate_key C:/sakura-certs/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        proxy_pass 127.0.0.1:8091;
        proxy_connect_timeout 3s;
        proxy_timeout 15m;
    }
}
